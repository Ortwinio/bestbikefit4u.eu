# Convex deployment identifier (used by Convex CLI commands)
CONVEX_DEPLOYMENT=your-team:your-deployment

# Public Convex endpoint used by Next.js client and server routes
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Public Convex site URL (used by Convex auth config fallback)
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public site URL used by auth redirects/magic links
SITE_URL=https://bikefitboost.com
NEXT_PUBLIC_SITE_URL=https://bikefitboost.com

# Salt used to hash client IPs for API route rate limiting
IP_HASH_SALT=replace-with-a-random-secret-value

# Optional in local development; required in production for real email delivery
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=BestBikeFit4U <noreply@notifications.bikefitboost.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional rollout switch: set to false to force legacy text PDF fallback
PDF_RICH_RENDER_ENABLED=true

# Optional rollout switch for background Engine v2 shadow comparisons
ENGINE_V2_SHADOW_ENABLED=false

# Default recommendation engine for newly created fit sessions (`v2` or `v1`)
ENGINE_VERSION_DEFAULT=v2

# Optional beta switch for dynamic validation capture APIs
ENGINE_V2_DYNAMIC_VALIDATION_ENABLED=false

# Optional beta switch for ride feedback and conservative refinement APIs
ENGINE_V2_FEEDBACK_BETA_ENABLED=false

# Comma-separated email allowlist for analytics KPI dashboard query access
ANALYTICS_ADMIN_EMAILS=support@bikefitboost.com

# Shared Redis-backed rate limiter for public endpoints (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry error monitoring DSN (optional; errors are silently dropped without it)
# Server-side: SENTRY_DSN, Client-side: NEXT_PUBLIC_SENTRY_DSN
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Analytics and ad conversion (optional — null-safe if absent)
NEXT_PUBLIC_GTM_ID=GTM-KH48ZSSC
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_PRICING_SIGNUP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CASE_STUDY_LABEL=

# OpenAI (optional — bike description generation)
OPENAI_API_KEY=
OPENAI_BIKE_DESCRIPTION_MODEL=gpt-4.1-mini

# Admin
ADMIN_BOOTSTRAP_SECRET=

# Stripe checkout (Vercel). Use actual Stripe price IDs, not product IDs.
# Set both to false to pause new purchases in the API and client UI.
STRIPE_BILLING_ENABLED=true
NEXT_PUBLIC_STRIPE_BILLING_ENABLED=true
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# Optional yearly subscription
STRIPE_PRO_YEARLY_PRICE_ID=
# Pricing model v2 (see shared/pricing.ts). Not read by checkout until step 02 lands.
STRIPE_ANNUAL_PRICE_ID=price_...
STRIPE_SINGLE_FIT_PRICE_ID=price_...
STRIPE_PERSONAL_FIT_ADDON_PRICE_ID=price_...
STRIPE_PERSONAL_FIT_STANDALONE_PRICE_ID=price_...
STRIPE_UPGRADE_COUPON_ID=UPGRADE_SINGLE_FIT_1200
# Stripe webhook verification (Convex production environment)
STRIPE_WEBHOOK_SECRET=whsec_...
