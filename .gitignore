# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# convex
# Keep generated Convex client files in git so clean CI/Vercel builds resolve imports.

# agent coordination (keep READMEs, exclude working files)
context/*
!context/README.md
!context/INDEX.md
messages/*
!messages/README.md
!messages/TEMPLATE.md
claude/.obsidian/

# temporary working files
/.tmp/

# Redesign review screenshots: kept locally for lead QA, not versioned
/plans/redesign-canvas/code-renders/
/plans/redesign-canvas/final-sweep/**/*.png
/plans/redesign-canvas/drafts/_renders/
/plans/redesign-canvas/audit/**/*.png
/plans/redesign-canvas/**/*.log
/plans/redesign-canvas/**/*.zip
/plans/redesign-canvas/final-sweep/smoke/*.png

# Editable illustration and image originals; generated web assets are committed
/plans/redesign-canvas/illustration-sources/

# Rider-profile review screenshots stay local (not versioned)
plans/riderprofile/renders/
